generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Bookmarks {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  postId String @db.ObjectId
  userId String @db.ObjectId
  post   Post   @relation(fields: [postId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  body      String
  createdAt DateTime @db.Date
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id])
  updatedAt DateTime @db.Date
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  body      String
  createdAt DateTime @db.Date
  postUrl   String?
  target    String
  type      String
  userId    String   @db.ObjectId
}

model Post {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  body      String
  createdAt DateTime    @db.Date
  likedIds  String[]
  updatedAt DateTime    @db.Date
  userId    String      @db.ObjectId
  user      User        @relation(fields: [userId], references: [id]) // Relation avec User
  bookmarks Bookmarks[] // Relation one-to-many avec Bookmark
  comments  Comment[] // Si vous avez un modèle Comment
}

model User {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  bio              String?
  bookmarksIds     String[]
  coverImage       String?
  createdAt        DateTime    @db.Date
  email            String      @unique
  followingIds     String[]
  hasNotifications Boolean?
  hashedPassword   String
  name             String
  profileImage     String?
  updatedAt        DateTime    @db.Date
  username         String      @unique
  posts            Post[] // Relation one-to-many avec Post
  bookmarks        Bookmarks[] // Relation one-to-many avec Bookmark
  Comment          Comment[]
}
